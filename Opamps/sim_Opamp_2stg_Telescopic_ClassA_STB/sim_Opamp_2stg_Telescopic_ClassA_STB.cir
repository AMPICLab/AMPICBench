.subckt Opamp_2stg_Telescopic_ClassA VCM Vbias_2 Vbias_3 Vbias_4 vm vout vp
  XI6 Vbias_3 Vbias_4 net3 vout ClassA_stg_PMOS
  XI7 VCM Vbias_2 Vbias_3 Vbias_4 vp net3 vm Telescopic_Amp
  CC1 net2 vout {Cc} m=1
  RR1 net2 net3 {Rz} m=1
.ends Opamp_2stg_Telescopic_ClassA
XI0 Vbiasn Vbiasp Bias_gen
XI2 Vbias_1 Vbias_2 Vbias_3 Vbias_4 Vbiasp Cascode_bias
* --- stb probe IPRB0: Tian double injection ---
Vprb_inj net6 vout 0 ac 1
Iprb_inj 0 net6 0 ac 0
VV2 VCM 0 dc {VCM}
VV4 vdd 0 dc {VDD}
VV0 vin 0 dc {VCM}
CC0 vout 0 1p m=1
XI1 VCM Vbias_2 Vbias_3 Vbias_4 net6 vout vin Opamp_2stg_Telescopic_ClassA

.control
set wr_singlescale
set wr_vecnames
option numdgt=7
op
show m : id vgs vds vth vdsat gm gds
print all > op_nodes.txt
show m : id vgs vds vth vdsat gm gds cgs cgd > op_devices.txt
* --- loop gain (equivalent of Spectre stb), Tian double injection ---
ac dec 50 10 10G
let lg_v1 = v(net6)
let lg_i1 = i(Vprb_inj)
alter Vprb_inj acmag=0
alter Iprb_inj acmag=1
ac dec 50 10 10G
let lg_v2 = v(net6)
let lg_i2 = i(Vprb_inj)
let v1 = ac1.lg_v1
let i1 = ac1.lg_i1
let loopgain = 1/(1/(2*(i1*lg_v2 - v1*lg_i2) + v1 + lg_i2) - 1)
let lg_db = db(loopgain)
let lg_ph = 180/pi*cph(loopgain)
wrdata stb.txt lg_db lg_ph
meas ac ugf when lg_db=0
meas ac pm_raw find lg_ph at=ugf
meas ac dcgain_db find lg_db at=10
meas ac f180 when lg_ph=-180
meas ac gm_db find lg_db at=f180
print ugf pm_raw dcgain_db f180 gm_db > stb_meas.txt
.endc
.end
