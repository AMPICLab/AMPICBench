  XPM0 vout Vbias_2 net097 vdd sky130_fd_pr__pfet_01v8_lvt W={Wp*1e6} L={Lp*1e6} nf=1 m=1 as={cds_as(Wp,1)} ad={cds_ad(Wp,1)} ps={cds_ps(Wp,1)} pd={cds_pd(Wp,1)}
  XPM5 Vbias5 Vbias_2 net016 vdd sky130_fd_pr__pfet_01v8_lvt W={Wp_finger*1e6} L={Lp*1e6} nf=1 m=1 as={cds_as(Wp_finger,1)} ad={cds_ad(Wp_finger,1)} ps={cds_ps(Wp_finger,1)} pd={cds_pd(Wp_finger,1)}
  XNM8 Vbias5 Vbias5 net015 0 sky130_fd_pr__nfet_01v8_lvt W={Wn_finger*1e6} L={Ln_*1e6} nf=1 m=1 as={cds_as(Wn_finger,1)} ad={cds_ad(Wn_finger,1)} ps={cds_ps(Wn_finger,1)} pd={cds_pd(Wn_finger,1)}
  XNM9 net015 VCM net014 0 sky130_fd_pr__nfet_01v8_lvt W={Wn_finger*1e6} L={Ln_*1e6} nf=1 m=1 as={cds_as(Wn_finger,1)} ad={cds_ad(Wn_finger,1)} ps={cds_ps(Wn_finger,1)} pd={cds_pd(Wn_finger,1)}
  XNM4 net8 Vbias_3 net012 0 sky130_fd_pr__nfet_01v8_lvt W={Wn*1e6} L={Ln_*1e6} nf=1 m=1 as={cds_as(Wn,1)} ad={cds_ad(Wn,1)} ps={cds_ps(Wn,1)} pd={cds_pd(Wn,1)}
